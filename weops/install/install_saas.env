#!/bin/bash
export BKAPP_CMDB_MONGO_HOST_CLUSTER=$(echo ${BK_MONGODB_IP_COMMA}|sed "s/,/:${BK_CMDB_MONGODB_PORT}&/g" |sed "s/$/&:${BK_CMDB_MONGODB_PORT}/g" )
export BKAPP_CMDB_VERSION=$(cat ${BK_PKG_SRC_PATH}/cmdb/VERSION)
export BKAPP_WEIXIN_APP_EXTERNAL_HOST=$(consul kv get bkcfg/fqdn/paas)
export CMDB_HREF=$(consul kv get bkcfg/fqdn/cmdb)
export JOB_HREF=$(consul kv get bkcfg/fqdn/job)
